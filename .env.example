# ---------------------------------------------------------------------------
# DeepSeek (OpenAI-compatible API: https://api.deepseek.com)
# Modelos atuais: deepseek-flash (tem visão) e deepseek-v4-pro (sem visão).
# Os antigos "deepseek-chat" e "deepseek-reasoner" foram aposentados em 2026-07-24.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VERIFY_MODEL=deepseek-flash

# Extração estruturada usa thinking DESLIGADO (necessário para JSON mode estável).
# Mude para true apenas em análises profundas sem tool/JSON estrito.
DEEPSEEK_THINKING=false
DEEPSEEK_REASONING_EFFORT=low

# Teto de gasto por auditoria, em USD. 0 = sem limite.
AI_BUDGET_USD=2

# Token de acesso à API e ao dashboard. Vazio = apenas desenvolvimento local.
# Em produção, defina um valor longo e aleatório (ex.: openssl rand -hex 32).
API_TOKEN=

# ---------------------------------------------------------------------------
# Execução
# ---------------------------------------------------------------------------
DATA_DIR=./data
PORT=4310
HOST=127.0.0.1
AUDIT_TIMEOUT_MS=120000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_VIEWPORT=1440x900

# Endpoint OTLP opcional (OpenTelemetry). Vazio = apenas JSONL local.
OTEL_EXPORTER_OTLP_ENDPOINT=
