# ---------------------------------------------------------------------------
# DeepSeek (OpenAI-compatible API: https://api.deepseek.com)
# Modelos atuais: deepseek-flash (tem visão) e deepseek-v4-pro (sem visão).
# Os antigos "deepseek-chat" e "deepseek-reasoner" foram aposentados em 2026-07-24.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VERIFY_MODEL=deepseek-flash
# segunda verificação com deepseek-v4-pro para achados P1 (custo extra)
DEEPSEEK_CONSENSUS_P1=false

# Extração estruturada usa thinking DESLIGADO (necessário para JSON mode estável).
# Mude para true apenas em análises profundas sem tool/JSON estrito.
DEEPSEEK_THINKING=false
DEEPSEEK_REASONING_EFFORT=low

# Teto de gasto por auditoria, em USD. 0 = sem limite.
AI_BUDGET_USD=2

# Ambiente: "production" exige API_TOKEN (fail-closed).
NODE_ENV=development

# Token de acesso à API e ao dashboard. Vazio = apenas desenvolvimento local.
# Em produção, defina um valor longo e aleatório (ex.: openssl rand -hex 32).
API_TOKEN=
# Escapa do fail-closed acima SOMENTE em desenvolvimento controlado.
ALLOW_INSECURE_NO_AUTH=false

# Segurança da API
CORS_ORIGIN=
LOGIN_RATE_LIMIT_MAX=5
SSE_TICKET_TTL_MS=120000
TRUST_PROXY=false
# Restringe alvos locais de auditoria/baseline (separados por vírgula). Vazio = permite qualquer
# diretório que não seja de sistema.
AUDIT_ALLOWED_ROOTS=
# Executar scripts npm do repositório auditado = código arbitrário. Só habilite em repos confiáveis.
AUDIT_ALLOW_NPM_SCRIPTS=false

# Gates do dataset de avaliação de IA
EVAL_MIN_PRECISION=0.7
EVAL_MIN_RECALL=0.7
EVAL_MIN_SEVERITY_ACCURACY=0.6

# ---------------------------------------------------------------------------
# Execução
# ---------------------------------------------------------------------------
DATA_DIR=./data
PORT=4310
HOST=127.0.0.1
AUDIT_TIMEOUT_MS=120000

# Limite de requisições por minuto por cliente na API (0 desliga)
RATE_LIMIT_MAX=120
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_VIEWPORT=1440x900

# Endpoint OTLP opcional (OpenTelemetry). Vazio = apenas JSONL local.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Webhook opcional: recebe um JSON quando um P1 novo aparece
WEBHOOK_URL=
WEBHOOK_SECRET=
