{
  "name": "autocorrecoes",
  "version": "1.0.0",
  "private": true,
  "description": "Auditoria e autocorreção de sites (design, backend e código) com DeepSeek como fiscalizador independente.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "autocorrecoes": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts serve",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "cli": "tsx src/cli/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx scripts/eval.ts",
    "doctor": "tsx src/cli/index.ts doctor"
  },
  "keywords": [
    "audit",
    "accessibility",
    "deepseek",
    "self-correction",
    "playwright",
    "axe-core"
  ],
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@fastify/static": "^8.3.0",
    "chrome-launcher": "^1.2.0",
    "commander": "^14.0.1",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "lighthouse": "^13.0.1",
    "playwright": "^1.56.1",
    "yaml": "^2.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
